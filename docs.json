{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "QuBe Sync",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": {
    "light": "/favicon.ico",
    "dark": "/favicon.ico"
  },
  "logo": {
    "light": "/logo/full-light.png",
    "dark": "/logo/full-dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@qubesync.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://qubesync.com/app"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "how-it-works"
            ]
          },
          {
            "group": "Build your integration",
            "pages": [
              "onboarding",
              "making-requests",
              "webhooks",
              "pagination",
              "matching",
              "error_handling"
            ]
          },
          {
            "group": "Workflows",
            "pages": [
              "workflows",
              "workflow-authoring"
            ]
          },
          {
            "group": "Test and launch",
            "pages": [
              "simulator",
              "going-live",
              "integration-checklist"
            ]
          },
          {
            "group": "Tools for you and your agent",
            "pages": [
              "cli",
              "mcp-server"
            ]
          },
          {
            "group": "Your dev environment",
            "pages": [
              "nfr-quickbooks",
              "ngrok",
              "qwc-logs"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "API v2",
            "openapi": {
              "source": "api-reference/v2/openapi.json",
              "directory": "api-reference/v2"
            }
          },
          {
            "group": "API v1 (legacy)",
            "openapi": {
              "source": "api-reference/v1/openapi.json",
              "directory": "api-reference/v1"
            }
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "QuBe Sync Slack",
          "href": "https://qubeintegrations.slack.com",
          "icon": "slack"
        }
      ]
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "redirects": [
    {
      "source": "/connecting",
      "destination": "/onboarding"
    },
    {
      "source": "/development",
      "destination": "/"
    },
    {
      "source": "/essentials/:slug*",
      "destination": "/"
    },
    {
      "source": "/api-reference",
      "destination": "/api-reference/introduction"
    },
    {
      "source": "/api-reference/connections/:slug*",
      "destination": "/api-reference/v1/connections/:slug*"
    },
    {
      "source": "/api-reference/queued-requests/:slug*",
      "destination": "/api-reference/v1/queued-requests/:slug*"
    },
    {
      "source": "/api-reference/pre-built-queries/:slug*",
      "destination": "/api-reference/v1/pre-built-queries/:slug*"
    }
  ],
  "footer": {
    "socials": {
      "github": "https://github.com/qubeintegrations",
      "linkedin": "https://linkedin.com/company/qube-integrations"
    }
  }
}
